# ─── Server ───────────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# ─── PostgreSQL ───────────────────────────────────────────────
DATABASE_URL=postgres://crednest:crednest@localhost:5432/crednest

# ─── MongoDB ──────────────────────────────────────────────────
MONGO_URL=mongodb://localhost:27017/crednest

# ─── Redis ────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Kafka ────────────────────────────────────────────────────
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=crednest-api-gateway
KAFKA_GROUP_ID=crednest-gateway-group

# ─── JWT ──────────────────────────────────────────────────────
JWT_SECRET=replace_with_strong_secret_min_32_chars
JWT_REFRESH_SECRET=replace_with_different_strong_secret_min_32_chars
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=30d

# ─── Encryption (AES-256-GCM for vault storage) ───────────────
ENCRYPTION_KEY=replace_with_64_hex_char_key_256bit
LOCAL_STORAGE_PATH=./vault_storage

# ─── Setu AA (Account Aggregator) ────────────────────────────
SETU_AA_BASE_URL=https://fiu-sandbox.setu.co
SETU_AA_CLIENT_ID=your_setu_aa_client_id
SETU_AA_CLIENT_SECRET=your_setu_aa_client_secret
SETU_AA_PRODUCT_INSTANCE_ID=your_setu_aa_product_instance_id

# ─── Setu GST ─────────────────────────────────────────────────
SETU_GST_BASE_URL=https://gst-sandbox.setu.co
SETU_GST_CLIENT_ID=your_setu_gst_client_id
SETU_GST_CLIENT_SECRET=your_setu_gst_client_secret

# ─── Setu DigiLocker ──────────────────────────────────────────
SETU_DIGILOCKER_BASE_URL=https://dg-sandbox.setu.co
SETU_DIGILOCKER_CLIENT_ID=your_setu_digilocker_client_id
SETU_DIGILOCKER_CLIENT_SECRET=your_setu_digilocker_client_secret

# ─── ML Service ───────────────────────────────────────────────
ML_SERVICE_URL=http://localhost:8000
USE_MOCK_ML_SERVICE=true

# ─── AWS KMS (or leave blank to use local ENCRYPTION_KEY) ─────
KMS_KEY_ID=

# ─── OCEN ─────────────────────────────────────────────────────
USE_MOCK_OCEN=true
